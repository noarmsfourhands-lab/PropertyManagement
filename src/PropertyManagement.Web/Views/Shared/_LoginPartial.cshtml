@*
    Sign-in state for the navigation bar. A partial rather than layout markup so the layout
    stays about structure and this stays about identity.
*@
<div class="tw-account">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <span class="tw-who">@User.Identity.Name</span>

        @if (User.IsInRole(UserRole.PropertyManager))
        {
            <span class="tw-role">Property manager</span>
        }
        else if (User.IsInRole(UserRole.Applicant))
        {
            <span class="tw-role">Applicant</span>
        }

        <form asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="btn btn-dark btn-sm">Sign out</button>
        </form>
    }
    else
    {
        <a class="nav-link" asp-controller="Account" asp-action="Register">Sign up</a>
        <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
    }
</div>
