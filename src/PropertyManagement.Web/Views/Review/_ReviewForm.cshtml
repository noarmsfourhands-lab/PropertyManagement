@model PropertyManagement.Web.ViewModels.Applications.ReviewFormViewModel
@using PropertyManagement.Domain.Enums

@* No refresh target: a decision changes the whole page, so the browser reloads it. *@
<form asp-action="Complete" method="post" data-modal-form>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ApplicationId" id="modal-ApplicationId" />

    <div class="modal-header">
        <h5 class="modal-title" id="app-modal-title">Complete review</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <p class="text-muted small">
            @Model.PropertyName &middot; Unit @Model.UnitNumber
            @if (!string.IsNullOrWhiteSpace(Model.ApplicantName))
            {
                <text>&middot; @Model.ApplicantName</text>
            }
        </p>

        <fieldset class="mb-3">
            <legend class="form-label fs-6">@Html.DisplayNameFor(m => m.Outcome)</legend>
            @foreach (var outcome in Enum.GetValues<ReviewOutcome>())
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Outcome"
                           value="@outcome" id="outcome-@outcome" />
                    <label class="form-check-label" for="outcome-@outcome">
                        @outcome
                        @if (PropertyManagement.Domain.Rules.ReviewRules.RequiresComment(outcome))
                        {
                            <span class="text-muted small">(comment required)</span>
                        }
                    </label>
                </div>
            }
            <span asp-validation-for="Outcome" class="text-danger small"></span>
        </fieldset>

        <div class="mb-0">
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" class="form-control" rows="4"
                      placeholder="Explain what the applicant needs to change, or why the application was denied."></textarea>
            <span asp-validation-for="Comment" class="text-danger small"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Record decision</button>
    </div>
</form>
