@model PropertyManagement.Web.ViewModels.Properties.AvailableUnitsBrowseViewModel
@{
    ViewData["Title"] = "Available units";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Available units</h1>
    <span class="badge text-bg-secondary">@Model.TotalCount available</span>
</div>

@if (Model.Units.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            <p class="mb-0">
                @(Model.Page > 1 ? "There is nothing on this page." : "No units are available at the moment.")
            </p>
            @if (Model.Page > 1)
            {
                <a class="btn btn-sm btn-outline-secondary mt-3" asp-action="Browse">Back to the first page</a>
            }
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Property</th>
                        <th scope="col">Unit</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-end">Bedrooms</th>
                        <th scope="col" class="text-end">Monthly rent</th>
                        @if (Model.CanApply)
                        {
                            <th scope="col" class="text-end">Apply</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @foreach (var unit in Model.Units)
                {
                    <tr>
                        <td>
                            @unit.Property?.Name
                            <div class="text-muted small">
                                @unit.Property?.AddressLine1, @unit.Property?.City @unit.Property?.State
                            </div>
                        </td>
                        <td class="fw-semibold">@unit.UnitNumber</td>
                        <td>@unit.UnitType?.Name</td>
                        <td class="text-end">@unit.Bedrooms</td>
                        <td class="text-end">@unit.MonthlyRent.ToString("C0")</td>
                        @if (Model.CanApply)
                        {
                            <td class="text-end">
                                <form asp-controller="RentalApplications" asp-action="Start" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="unitId" value="@unit.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary">Apply</button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                Availability as of @Model.AsOf.ToString("d MMMM yyyy").
                @if (Model.PageCount > 1)
                {
                    <text>Page @Model.Page of @Model.PageCount.</text>
                }
            </span>

            @if (Model.PageCount > 1)
            {
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")"
                       asp-action="Browse" asp-route-page="@(Model.Page - 1)">Previous</a>
                    <a class="btn btn-outline-secondary @(Model.HasNext ? "" : "disabled")"
                       asp-action="Browse" asp-route-page="@(Model.Page + 1)">Next</a>
                </div>
            }
        </div>
    </div>
}
