@{
    ViewData["Title"] = "Home";
}

<div class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h1 class="h3">Property Management</h1>

        @if (User.IsInRole(UserRole.PropertyManager))
        {
            <p class="text-muted mb-3">Maintain properties and their units, and review rental applications.</p>
            <a class="btn btn-primary" asp-controller="Properties" asp-action="Index">Open properties</a>
        }
        else
        {
            <p class="text-muted mb-0">Browse the units available now and apply for the one you want.</p>
        }
    </div>
</div>

@* A view component: it runs its own query and renders its own view, so this page stays simple. *@
@await Component.InvokeAsync("AvailableUnits", new { maximum = 8 })
