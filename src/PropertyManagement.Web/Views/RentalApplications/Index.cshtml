@model PropertyManagement.Web.ViewModels.Applications.ApplicationListViewModel
@using PropertyManagement.Web.ViewModels.Applications
@{
    ViewData["Title"] = "Applications";
    var results = Model.Results;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Applications</h1>
    <span class="text-muted small">
        @(Model.ShowsEveryApplicant ? "Every applicant" : "Your applications")
    </span>
</div>

@*
    A plain GET form. The filter values land in the query string, so a filtered list can be
    bookmarked and shared, and every filter is applied by the database rather than in memory.
*@
<form asp-action="Index" method="get" class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label asp-for="Status" class="form-label small mb-1">Status</label>
                <select asp-for="Status" asp-items="Model.StatusChoices" class="form-select form-select-sm">
                    <option value="">Any status</option>
                </select>
            </div>
            <div class="col-sm-4">
                <label asp-for="PropertyId" class="form-label small mb-1">Property</label>
                <select asp-for="PropertyId" asp-items="Model.PropertyChoices" class="form-select form-select-sm">
                    <option value="">Any property</option>
                </select>
            </div>
            <div class="col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary">Apply filters</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear</a>
            </div>
        </div>
    </div>
</form>

@if (results.Rows.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center text-muted py-5">
            <p class="mb-0">No applications match these filters.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Property</th>
                        <th scope="col">Unit</th>
                        @if (Model.ShowsEveryApplicant)
                        {
                            <th scope="col">Applicant</th>
                        }
                        <th scope="col">Status</th>
                        <th scope="col">Submitted</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in results.Rows)
                {
                    <tr>
                        <td>@row.PropertyName</td>
                        <td class="fw-semibold">@row.UnitNumber</td>
                        @if (Model.ShowsEveryApplicant)
                        {
                            <td>@(string.IsNullOrWhiteSpace(row.ApplicantName) ? "Not yet provided" : row.ApplicantName)</td>
                        }
                        <td>
                            <span class="badge @ApplicationListViewModel.BadgeClassFor(row.Status)">
                                @ApplicationListViewModel.DisplayNameFor(row.Status)
                            </span>
                        </td>
                        <td class="small text-muted">
                            @(row.SubmittedAtUtc?.ToLocalTime().ToString("d MMM yyyy") ?? "Not submitted")
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-action="Edit" asp-route-id="@row.Id">Open</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (results.PageCount > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Page @results.Page of @results.PageCount &middot; @results.TotalCount application(s)
                </span>
                <div class="btn-group btn-group-sm">
                    <a class="btn btn-outline-secondary @(results.HasPrevious ? "" : "disabled")"
                       asp-action="Index"
                       asp-route-status="@Model.Status"
                       asp-route-propertyId="@Model.PropertyId"
                       asp-route-page="@(results.Page - 1)">Previous</a>
                    <a class="btn btn-outline-secondary @(results.HasNext ? "" : "disabled")"
                       asp-action="Index"
                       asp-route-status="@Model.Status"
                       asp-route-propertyId="@Model.PropertyId"
                       asp-route-page="@(results.Page + 1)">Next</a>
                </div>
            </div>
        }
    </div>
}
