@model PropertyManagement.Web.ViewModels.Applications.ApplicationListViewModel
@{
    ViewData["Title"] = "Applications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Applications</h1>
    <span class="text-muted small">
        @(Model.ShowsEveryApplicant ? "Every applicant" : "Your applications")
    </span>
</div>

@*
    The list itself is the reusable grid component. This page only says what to fetch and which
    columns to show; the grid handles sorting, filtering and paging against the JSON endpoint,
    and the database does all three.
*@
@await Component.InvokeAsync("DataGrid", new { model = Model.ToGrid(Url.Content("~/api/applications")) })

@section Scripts {
    <script src="~/js/data-grid.js" asp-append-version="true"></script>
}
