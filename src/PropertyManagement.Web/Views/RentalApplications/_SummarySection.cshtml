@model PropertyManagement.Web.ViewModels.Applications.ApplicationWizardViewModel
@*
    The Summary is a read-only view of both sections. It reuses the very same partials: because
    the current section is the Summary, the model reports the sections as not editable, so they
    render as text without this view having to ask for a different mode.
*@
<h2 class="h5 mb-3">Summary</h2>

@if (Model.CanEdit && Model.Problems.Count > 0)
{
    @*
        Everything still standing between this application and being submitted, grouped by the
        section it belongs to, with a link straight to that section.
    *@
    <div class="alert alert-warning">
        <p class="fw-semibold mb-2">Still to fix before you can submit</p>

        @foreach (var group in Model.ProblemsBySection)
        {
            <p class="mb-1 mt-2">
                <a asp-action="Edit" asp-route-id="@Model.ApplicationId" asp-route-section="@group.Key">
                    @PropertyManagement.Web.ViewModels.Applications.SectionValidation.SectionLabel(group.Key)
                </a>
            </p>
            <ul class="mb-0 small">
            @foreach (var problem in group)
            {
                <li>@problem.Message</li>
            }
            </ul>
        }
    </div>
}

<div class="mb-4">
    <partial name="_ApplicantInformationSection" model="Model" />
</div>

<hr class="my-4" />

<div>
    <partial name="_ResidenceHistorySection" model="Model" />
</div>
