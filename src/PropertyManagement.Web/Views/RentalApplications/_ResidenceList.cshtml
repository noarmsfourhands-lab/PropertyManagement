@model PropertyManagement.Web.ViewModels.Applications.ResidenceListViewModel

@if (Model.IsEmpty)
{
    <div class="border rounded text-center text-muted py-4">
        <p class="mb-0">No previous residences added yet.</p>
    </div>
}
else
{
    <div class="table-responsive border rounded">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Address</th>
                    <th scope="col">Landlord</th>
                    <th scope="col">Dates</th>
                    @if (Model.Editable)
                    {
                        <th scope="col" class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var residence in Model.Residences)
            {
                <tr>
                    <td>
                        @residence.AddressLine1
                        @if (!string.IsNullOrWhiteSpace(residence.AddressLine2))
                        {
                            <br />@residence.AddressLine2
                        }
                        <br /><span class="text-muted small">@residence.City @residence.State @residence.PostalCode</span>
                    </td>
                    <td>
                        @residence.LandlordName
                        <br /><span class="text-muted small">@residence.LandlordPhone</span>
                    </td>
                    <td class="small">
                        @residence.MoveInDate.ToString("MMM yyyy")
                        &ndash;
                        @(residence.MoveOutDate?.ToString("MMM yyyy") ?? "present")
                    </td>
                    @if (Model.Editable)
                    {
                        <td class="text-end text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-modal-url="@Url.Action("ResidenceForm", new { id = residence.Id, applicationId = Model.ApplicationId })">
                                Edit
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-modal-url="@Url.Action("ConfirmDeleteResidence", new { id = residence.Id, applicationId = Model.ApplicationId })">
                                Remove
                            </button>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
