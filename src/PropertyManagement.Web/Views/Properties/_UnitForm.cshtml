@model PropertyManagement.Web.ViewModels.Properties.UnitFormViewModel

<form asp-action="SaveUnit" method="post"
      data-modal-form
      data-refresh-target="#unit-list"
      data-refresh-url="@Url.Action("UnitListPartial", new { id = Model.PropertyId })">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PropertyId" />

    <div class="modal-header">
        <h5 class="modal-title">@Model.Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="UnitNumber" class="form-label"></label>
                <input asp-for="UnitNumber" class="form-control" />
                <span asp-validation-for="UnitNumber" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="UnitTypeId" class="form-label"></label>
                <select asp-for="UnitTypeId" asp-items="Model.UnitTypeChoices" class="form-select">
                    <option value="0">Choose a type</option>
                </select>
                <span asp-validation-for="UnitTypeId" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="Bedrooms" class="form-label"></label>
                <input asp-for="Bedrooms" class="form-control" type="number" min="0" max="10" />
                <span asp-validation-for="Bedrooms" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="MonthlyRent" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="MonthlyRent" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="MonthlyRent" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
