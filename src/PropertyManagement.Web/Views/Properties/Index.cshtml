@model IReadOnlyList<Property>
@{
    ViewData["Title"] = "Properties";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Properties</h1>
    @* data-modal-url is all a trigger needs; the controller action supplies the modal body. *@
    <button type="button" class="btn btn-primary"
            data-modal-url="@Url.Action("Form", new { id = 0 })">
        Add property
    </button>
</div>

@* The region the modal refreshes on success, so the rest of the page is left alone. *@
<div id="property-list">
    <partial name="_PropertyList" model="Model" />
</div>
