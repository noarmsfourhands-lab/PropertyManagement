@model PropertyManagement.Web.ViewModels.Properties.PropertyFormViewModel
@*
    The modal body for adding or editing a property.

    This same partial is returned by the GET that opens the modal and by the POST that fails
    validation, so the two paths cannot drift apart. data-modal-form opts the form into the
    fetch-based submit; data-refresh-target names the region to replace on success.
*@

<form asp-action="Save" method="post"
      data-modal-form
      data-refresh-target="#property-list"
      data-refresh-url="@Url.Action("ListPartial")">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="modal-header">
        <h5 class="modal-title">@Model.Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AddressLine1" class="form-label"></label>
            <input asp-for="AddressLine1" class="form-control" />
            <span asp-validation-for="AddressLine1" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AddressLine2" class="form-label"></label>
            <input asp-for="AddressLine2" class="form-control" />
            <span asp-validation-for="AddressLine2" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-sm-3 mb-3">
                <label asp-for="State" class="form-label"></label>
                <input asp-for="State" class="form-control" />
                <span asp-validation-for="State" class="text-danger small"></span>
            </div>
            <div class="col-sm-3 mb-3">
                <label asp-for="PostalCode" class="form-label"></label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
