@model PropertyManagement.Web.ViewModels.Applications.NoteFormViewModel

<form asp-controller="Notes" asp-action="Save" method="post"
      data-modal-form
      data-refresh-target="#note-list"
      data-refresh-url="@Url.Action("ListPartial", "Notes", new { id = Model.ApplicationId })">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ApplicationId" />

    <div class="modal-header">
        <h5 class="modal-title">@Model.Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-0">
            <label asp-for="Body" class="form-label"></label>
            <textarea asp-for="Body" class="form-control" rows="5"
                      placeholder="Anything the review team should know. Applicants never see this."></textarea>
            <span asp-validation-for="Body" class="text-danger small"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
