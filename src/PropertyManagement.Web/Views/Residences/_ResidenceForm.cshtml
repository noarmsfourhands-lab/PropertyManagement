@model PropertyManagement.Web.ViewModels.Applications.ResidenceFormViewModel

<form asp-action="Save" asp-controller="Residences" method="post"
      data-modal-form
      data-refresh-target="#residence-list"
      data-clears="[data-clear-on-success]"
      data-refresh-url="@Url.Action("ListPartial", "Residences", new { id = Model.ApplicationId })">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Version" />
    <input type="hidden" asp-for="ApplicationId" id="modal-ApplicationId" />

    <div class="modal-header">
        <h5 class="modal-title" id="app-modal-title">@Model.Title</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label asp-for="AddressLine1" class="form-label"></label>
            <input asp-for="AddressLine1" class="form-control" />
            <span asp-validation-for="AddressLine1" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="AddressLine2" class="form-label"></label>
            <input asp-for="AddressLine2" class="form-control" />
            <span asp-validation-for="AddressLine2" class="text-danger small"></span>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger small"></span>
            </div>
            <div class="col-sm-3 mb-3">
                <label asp-for="State" class="form-label"></label>
                <input asp-for="State" class="form-control" />
                <span asp-validation-for="State" class="text-danger small"></span>
            </div>
            <div class="col-sm-3 mb-3">
                <label asp-for="PostalCode" class="form-label"></label>
                <input asp-for="PostalCode" class="form-control" />
                <span asp-validation-for="PostalCode" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="LandlordName" class="form-label"></label>
                <input asp-for="LandlordName" class="form-control" />
                <span asp-validation-for="LandlordName" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="LandlordPhone" class="form-label"></label>
                <input asp-for="LandlordPhone" class="form-control" />
                <span asp-validation-for="LandlordPhone" class="text-danger small"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="MoveInDate" class="form-label"></label>
                <input asp-for="MoveInDate" class="form-control" type="date" />
                <span asp-validation-for="MoveInDate" class="text-danger small"></span>
            </div>
            <div class="col-sm-6 mb-3">
                <label asp-for="MoveOutDate" class="form-label"></label>
                <input asp-for="MoveOutDate" class="form-control" type="date" />
                <div class="form-text">Leave blank if you still live there.</div>
                <span asp-validation-for="MoveOutDate" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
